# Database
DATABASE_URL=postgresql://cadmus:cadmus@localhost:5432/cadmus

# API
PORT=3001
JWT_SECRET=           # openssl rand -base64 32

# AI (at least one required)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Storage
GCS_BUCKET=

# Web (Astro, build-time)
PUBLIC_API_URL=http://localhost:3001
PUBLIC_SITE_ID=demo   # dev only

# Admin (Vite, build-time)
VITE_API_URL=
VITE_SITE_URL=

# GCP deploy scripts
GCP_PROJECT=
GCP_REGION=us-central1
CLOUD_SQL_INSTANCE=cadmus
API_SERVICE_NAME=cadmus-api
WEB_SERVICE_NAME=cadmus-web
ADMIN_BUCKET=              # defaults to ${GCP_PROJECT}-admin
MEDIA_BUCKET=              # defaults to ${GCP_PROJECT}-media

# Turnstile spam protection (add-on) — platform-wide keys; a site can BYO via
# its add-on config (sitekey / secretKey). Client sitekey reaches the browser
# only through the public add-ons payload.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Auto-provisioning for custom-domain sites: pool widgets are created/updated
# via the Turnstile API. Token needs Account > Turnstile > Edit. Optional —
# without it, custom-domain sites fall back to BYO keys.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TURNSTILE_API_TOKEN=

# Email (Mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=            # e.g. mail.yourdomain.com
# MAILGUN_REGION=us        # "us" (default) or "eu"
