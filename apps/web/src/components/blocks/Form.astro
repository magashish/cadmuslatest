---
interface FormField {
  name: string;
  type: "text" | "email" | "textarea" | "phone" | "select" | "checkbox";
  label: string;
  required?: boolean;
  options?: string[];
  placeholder?: string;
}

interface Props {
  variant: "contact" | "newsletter" | "custom";
  fields: FormField[];
  submitText: string;
  successMessage?: string;
  notificationEmail?: string;
  confirmationEnabled?: boolean;
  confirmationMessage?: string;
  redirectUrl?: string;
  formIdentifier?: string;
}

const {
  variant,
  fields,
  submitText,
  successMessage = "Thank you for your submission!",
  redirectUrl,
  formIdentifier,
} = Astro.props;

const defaultContactFields: FormField[] = [
  { name: "name", type: "text", label: "Name", required: true },
  { name: "email", type: "email", label: "Email", required: true },
  { name: "message", type: "textarea", label: "Message", required: true },
];

const defaultNewsletterFields: FormField[] = [
  { name: "email", type: "email", label: "Email Address", required: true },
];

const resolvedFields = variant === "contact" && fields.length === 0
  ? defaultContactFields
  : variant === "newsletter" && fields.length === 0
    ? defaultNewsletterFields
    : fields;
---

<section class={`form form--${variant}`}>
  <form
    class="form__container"
    data-success-message={successMessage}
    data-redirect-url={redirectUrl}
    data-form-identifier={formIdentifier}
  >
    <div class="form__fields">
      {resolvedFields.map((field, fi) => {
        const fieldId = field.name || `field-${fi}`;
        if (field.type === "checkbox") {
          // Checkbox: the label is the agreement text, sitting next to the box.
          return (
            <div class="form__field form__field--checkbox">
              <label class="form__checkbox-label" for={fieldId}>
                <input
                  id={fieldId}
                  name={field.name || fieldId}
                  type="checkbox"
                  value="yes"
                  class="form__checkbox"
                  required={field.required}
                />
                <span>
                  {field.label}
                  {field.required && <span class="form__required">*</span>}
                </span>
              </label>
            </div>
          );
        }
        return (
        <div class={`form__field form__field--${field.type}`}>
          <label class="form__label" for={fieldId}>
            {field.label}
            {field.required && <span class="form__required">*</span>}
          </label>
          {field.type === "textarea" ? (
            <textarea
              id={fieldId}
              name={field.name || fieldId}
              class="form__input form__textarea"
              required={field.required}
              rows="4"
              placeholder={field.placeholder || `Enter your ${field.label.toLowerCase()}...`}
            />
          ) : field.type === "select" ? (
            <select
              id={fieldId}
              name={field.name || fieldId}
              class="form__input form__select"
              required={field.required}
            >
              <option value="">{field.placeholder || "Select..."}</option>
              {field.options?.map((opt) => (
                <option value={opt}>{opt}</option>
              ))}
            </select>
          ) : field.type === "file" ? (
            <input
              id={fieldId}
              name={field.name || fieldId}
              type="file"
              class="form__input form__file"
              required={field.required}
              accept=".pdf,.png,.jpg,.jpeg,.gif,.webp,.txt,.csv,.doc,.docx,.xls,.xlsx"
            />
          ) : (
            <input
              id={fieldId}
              name={field.name || fieldId}
              type={field.type === "phone" ? "tel" : field.type}
              class="form__input"
              required={field.required}
              placeholder={field.placeholder || `Enter your ${field.label?.toLowerCase() || ""}...`}
            />
          )}
        </div>
        );
      })}
    </div>
    <div class="form__hp" aria-hidden="true">
      <label>Leave this field blank
        <input type="text" name="_hp" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <button type="submit" class="form__submit">{submitText}</button>
  </form>
</section>

<script>
  import "@/scripts/form-handler.ts";
</script>

<style>
  .form {
    padding: calc(var(--spacing-unit, 8px) * 6) 0;
  }

  .form__hp {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__container {
    max-width: 600px;
  }

  .form--newsletter .form__container {
    max-width: 480px;
  }

  .form--newsletter .form__fields {
    display: flex;
    gap: calc(var(--spacing-unit, 8px) * 1.5);
    align-items: flex-end;
  }

  .form--newsletter .form__field {
    flex: 1;
  }

  .form__fields {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing-unit, 8px) * 2.5);
  }

  .form__label {
    display: block;
    font-weight: 600;
    margin-bottom: calc(var(--spacing-unit, 8px) * 0.75);
    font-size: 0.875rem;
    font-family: var(--font-heading, system-ui);
  }

  .form__required {
    color: #e53e3e;
    margin-left: 2px;
  }

  .form__checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: calc(var(--spacing-unit, 8px) * 1.25);
    font-family: var(--font-body, system-ui);
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-text, #1a1a1a);
    cursor: pointer;
  }

  .form__checkbox {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.1rem;
    flex-shrink: 0;
    accent-color: var(--color-primary, #1a1a1a);
    cursor: pointer;
  }

  .form__input {
    width: 100%;
    padding: calc(var(--spacing-unit, 8px) * 1.5) calc(var(--spacing-unit, 8px) * 2);
    border: 1.5px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-md, 8px);
    font-family: var(--font-body, system-ui);
    font-size: 1rem;
    background: var(--color-surface, #fff);
    color: var(--color-text, #1a1a1a);
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }

  .form__input::placeholder {
    color: var(--color-text-muted, #999);
    opacity: 0.6;
  }

  .form__input:focus {
    outline: none;
    border-color: var(--color-primary, #1a1a1a);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary, #1a1a1a) 15%, transparent);
  }

  .form__input:invalid:not(:placeholder-shown):not(:focus) {
    border-color: #e53e3e;
  }

  .form__textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form__submit {
    margin-top: calc(var(--spacing-unit, 8px) * 3);
    display: inline-block;
    padding: calc(var(--spacing-unit, 8px) * 1.75) calc(var(--spacing-unit, 8px) * 4);
    background: var(--color-primary, #1a1a1a);
    color: #fff;
    border: none;
    border-radius: var(--radius-md, 8px);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s, background 0.15s;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .form__submit:hover {
    background: var(--color-primary-hover, #333);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
  }

  .form__submit:active {
    transform: translateY(0);
  }

  .form__submit:focus-visible {
    outline: 2px solid var(--color-primary, #1a1a1a);
    outline-offset: 2px;
  }

  .form--newsletter .form__submit {
    margin-top: 0;
  }

  @media (max-width: 768px) {
    .form--newsletter .form__fields {
      flex-direction: column;
    }

    .form--newsletter .form__submit {
      margin-top: calc(var(--spacing-unit, 8px) * 2);
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .form__submit {
      transition: none;
    }
  }
</style>
