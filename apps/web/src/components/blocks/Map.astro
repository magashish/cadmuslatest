---
import { sanitizeRichText } from "../../lib/sanitize";

interface Props {
  variant: "default" | "with-info" | "full-width";
  address: string;
  lat?: number;
  lng?: number;
  zoom?: number;
  businessName?: string;
  phone?: string;
  hours?: string;
}

const { variant, address, lat, lng, zoom = 14, businessName, phone, hours } = Astro.props;
const safeHours = hours ? sanitizeRichText(hours) : undefined;

const encodedAddress = encodeURIComponent(address);
const mapSrc = lat && lng
  ? `https://maps.google.com/maps?q=${lat},${lng}&z=${zoom}&output=embed`
  : `https://maps.google.com/maps?q=${encodedAddress}&z=${zoom}&output=embed`;
---

<section class={`map map--${variant}`}>
  <div class="map__container">
    <div class="map__embed">
      <iframe
        src={mapSrc}
        title={`Map of ${businessName || address}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
    {variant === "with-info" && (
      <div class="map__info">
        {businessName && <h3 class="map__business-name">{businessName}</h3>}
        <address class="map__address">{address}</address>
        {phone && (
          <p class="map__phone">
            <a href={`tel:${phone}`}>{phone}</a>
          </p>
        )}
        {safeHours && <p class="map__hours" set:html={safeHours} />}
      </div>
    )}
  </div>
</section>

<style>
  .map {
    padding: calc(var(--spacing-unit, 8px) * 6) 0;
  }

  .map--full-width {
    padding: 0;
  }

  .map--with-info .map__container {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: calc(var(--spacing-unit, 8px) * 4);
    align-items: start;
  }

  .map__embed {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: var(--radius-lg, 16px);
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
  }

  .map--full-width .map__embed {
    border-radius: 0;
    padding-bottom: 40%;
    box-shadow: none;
  }

  .map__embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map__info {
    padding: calc(var(--spacing-unit, 8px) * 3);
    background: var(--color-surface, #f8f9fa);
    border-radius: var(--radius-lg, 16px);
    border: 1px solid var(--color-border, #e2e8f0);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
  }

  .map__business-name {
    font-family: var(--font-heading, system-ui);
    margin: 0 0 calc(var(--spacing-unit, 8px) * 1.5);
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }

  .map__address {
    font-style: normal;
    color: var(--color-text-muted, #666);
    line-height: 1.6;
    margin-bottom: calc(var(--spacing-unit, 8px) * 1.5);
  }

  .map__phone a {
    color: var(--color-primary, #1a1a1a);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s;
  }

  .map__phone a:hover {
    text-decoration: underline;
  }

  .map__hours {
    margin-top: calc(var(--spacing-unit, 8px) * 1.5);
    color: var(--color-text-muted, #666);
    line-height: 1.6;
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .map--with-info .map__container {
      grid-template-columns: 1fr;
    }

    .map--full-width .map__embed {
      padding-bottom: 75%;
    }
  }
</style>
