---
import { sanitizeRichText } from "../../lib/sanitize";

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  variant: "accordion" | "two-col" | "simple";
  items: FAQItem[];
}

const { variant, items } = Astro.props;
const safeItems = items.map((item) => ({
  question: item.question,
  answer: sanitizeRichText(item.answer),
}));
---

<section class={`faq faq--${variant}`}>
  <div class="faq__list">
    {safeItems.map((item) => (
      <details class="faq__item">
        <summary class="faq__question">
          <span>{item.question}</span>
          <svg class="faq__chevron" width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="faq__answer" set:html={item.answer} />
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    padding: calc(var(--spacing-unit, 8px) * 6) 0;
  }

  .faq--two-col .faq__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(var(--spacing-unit, 8px) * 2);
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-sm, 4px);
  }

  .faq__question {
    font-weight: 600;
    cursor: pointer;
    font-family: var(--font-heading, system-ui);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: calc(var(--spacing-unit, 8px) * 2) calc(var(--spacing-unit, 8px) * 1);
    border-radius: var(--radius-sm, 4px);
    transition: background 0.2s;
    gap: 1rem;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    background: var(--color-surface, #f8f9fa);
  }

  .faq__chevron {
    flex-shrink: 0;
    transition: transform 0.3s;
    color: var(--color-text-muted, #666);
  }

  details[open] .faq__chevron {
    transform: rotate(180deg);
  }

  .faq__answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
    overflow: hidden;
  }

  details[open] .faq__answer {
    grid-template-rows: 1fr;
  }

  .faq__answer > :global(*) {
    overflow: hidden;
  }

  .faq__answer {
    padding: 0 calc(var(--spacing-unit, 8px) * 1) calc(var(--spacing-unit, 8px) * 2);
    color: var(--color-text-muted, #666);
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .faq--two-col .faq__list {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__chevron {
      transition: none;
    }
  }
</style>
