---
import { sanitizeRichText } from "../../lib/sanitize";

interface Props {
  variant: "single-col" | "single-col-dropcap" | "two-col" | "with-image";
  content: string;
  imageUrl?: string;
  imagePosition?: "left" | "right";
}

const { variant, content, imageUrl, imagePosition = "right" } = Astro.props;
const safeContent = sanitizeRichText(content);
---

<section class={`text-section text-section--${variant} ${imagePosition === "left" ? "text-section--img-left" : ""}`}>
  {variant === "with-image" && imageUrl && imagePosition === "left" && (
    <div class="text-section__image">
      <img src={imageUrl} alt="" />
    </div>
  )}
  <div class="text-section__content" set:html={safeContent} />
  {variant === "with-image" && imageUrl && imagePosition === "right" && (
    <div class="text-section__image">
      <img src={imageUrl} alt="" />
    </div>
  )}
</section>

<style>
  .text-section {
    padding: calc(var(--spacing-unit, 8px) * 6) 0;
    font-family: var(--font-body, system-ui);
    line-height: 1.75;
  }

  .text-section--two-col .text-section__content {
    columns: 2;
    column-gap: calc(var(--spacing-unit, 8px) * 6);
    column-rule: 1px solid var(--color-border, #e2e8f0);
  }

  .text-section--with-image {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(var(--spacing-unit, 8px) * 6);
    align-items: center;
  }

  .text-section__image img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg, 16px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  }

  /* Drop-cap is opt-in via the single-col-dropcap variant. Default text
     sections (single-col, two-col, with-image) render plain prose so info
     pages with multiple text blocks don't get a giant first-letter on
     every section. */
  .text-section--single-col-dropcap .text-section__content :global(p:first-of-type::first-letter) {
    float: left;
    font-size: 3.2em;
    line-height: 0.8;
    padding-right: 0.08em;
    font-weight: 700;
    font-family: var(--font-heading, system-ui);
    color: var(--color-primary, #1a1a1a);
  }

  .text-section__content :global(h1),
  .text-section__content :global(h2),
  .text-section__content :global(h3),
  .text-section__content :global(h4),
  .text-section__content :global(h5),
  .text-section__content :global(h6) {
    font-family: var(--font-heading, system-ui);
    font-weight: 700;
    line-height: 1.25;
    margin: calc(var(--spacing-unit, 8px) * 4) 0 calc(var(--spacing-unit, 8px) * 2);
    color: var(--color-text, inherit);
  }

  .text-section__content :global(h1) { font-size: 2.25rem; }
  .text-section__content :global(h2) { font-size: 1.75rem; }
  .text-section__content :global(h3) { font-size: 1.375rem; }
  .text-section__content :global(h4) { font-size: 1.125rem; }
  .text-section__content :global(h5) { font-size: 1rem; }
  .text-section__content :global(h6) { font-size: 0.875rem; }

  .text-section__content :global(p) {
    margin: calc(var(--spacing-unit, 8px) * 2) 0;
  }

  .text-section__content :global(blockquote) {
    border-left: 3px solid var(--color-primary, #1a1a1a);
    margin: calc(var(--spacing-unit, 8px) * 3) 0;
    padding: calc(var(--spacing-unit, 8px) * 2) calc(var(--spacing-unit, 8px) * 3);
    background: var(--color-surface, #f8f9fa);
    border-radius: 0 var(--radius-md, 8px) var(--radius-md, 8px) 0;
    font-style: italic;
    color: var(--color-text-muted, #555);
  }

  .text-section__content :global(ul) {
    list-style-type: disc;
    padding-left: 1.5em;
    margin: calc(var(--spacing-unit, 8px) * 2) 0;
  }

  .text-section__content :global(ol) {
    list-style-type: decimal;
    padding-left: 1.5em;
    margin: calc(var(--spacing-unit, 8px) * 2) 0;
  }

  .text-section__content :global(ul ul) { list-style-type: circle; }
  .text-section__content :global(ul ul ul) { list-style-type: square; }

  .text-section__content :global(li) {
    margin-bottom: calc(var(--spacing-unit, 8px) * 0.75);
  }

  .text-section__content :global(a) {
    color: var(--color-primary, #1a1a1a);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: text-decoration-thickness 0.15s;
  }

  .text-section__content :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  @media (max-width: 768px) {
    .text-section--two-col .text-section__content {
      columns: 1;
    }

    .text-section--with-image {
      grid-template-columns: 1fr;
    }

    .text-section--single-col-dropcap .text-section__content :global(p:first-of-type::first-letter) {
      float: none;
      font-size: inherit;
      padding-right: 0;
      font-weight: inherit;
      color: inherit;
    }
  }
</style>
