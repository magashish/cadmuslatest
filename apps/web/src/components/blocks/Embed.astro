---
import { sanitizeEmbed } from "../../lib/sanitize";

interface Props {
  variant: "default";
  html: string;
}

const { html } = Astro.props;
const safeHtml = sanitizeEmbed(html);
---

<section class="embed">
  <div class="embed__container">
    <div class="embed__sandbox" set:html={safeHtml} />
  </div>
</section>

<style>
  .embed {
    padding: calc(var(--spacing-unit, 8px) * 6) 0;
  }

  .embed__container {
    max-width: 100%;
    overflow: hidden;
  }

  .embed__sandbox {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md, 8px);
    border: 1px solid var(--color-border, #e2e8f0);
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.04);
  }

  .embed__sandbox :global(iframe) {
    max-width: 100%;
    aspect-ratio: 16 / 9;
    width: 100%;
    height: auto;
    display: block;
  }

  .embed__sandbox :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
